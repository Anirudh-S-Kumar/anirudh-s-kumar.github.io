		"@tailwindcss/vite": "^4.2.1",
		"autoprefixer": "^10.4.20",
		"gh-pages": "^6.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.0",
		"vite": "^6.0.0"
	},
	"type": "module"
